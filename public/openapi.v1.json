{
  "openapi": "3.1.0",
  "info": {
    "title": "Detective Town Agent API",
    "version": "v1",
    "description": "Stable external-agent subset for Detective Town / Living World Lab. All successful responses use { ok: true, data }; failures use { ok: false, error }."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/v1/query/runtime/status": {
      "get": {
        "summary": "Inspect runtime status and advertised capabilities",
        "responses": {
          "200": { "$ref": "#/components/responses/Ok" }
        }
      }
    },
    "/api/v1/command/town/create": {
      "post": {
        "summary": "Create a Detective Town world",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/town/runtime/start": {
      "post": {
        "summary": "Start a persistent town runtime",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/town/runtime/step": {
      "post": {
        "summary": "Advance a persistent town runtime",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/town/runtime/pause": {
      "post": {
        "summary": "Pause a persistent town runtime",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/town/runtime/reset": {
      "post": {
        "summary": "Reset a persistent town runtime",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/town/agents": {
      "get": {
        "summary": "List persistent town agent states",
        "parameters": [{ "$ref": "#/components/parameters/WorldId" }],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/town/agent": {
      "get": {
        "summary": "Inspect one persistent town agent",
        "parameters": [
          { "$ref": "#/components/parameters/WorldId" },
          { "$ref": "#/components/parameters/NpcId" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/town/candidates": {
      "get": {
        "summary": "List case emergence candidates",
        "parameters": [{ "$ref": "#/components/parameters/WorldId" }],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/case": {
      "get": {
        "summary": "Load a case, optionally with spoiler-safe playable intake",
        "parameters": [
          { "name": "caseId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "includeIntake", "in": "query", "required": false, "schema": { "type": "boolean" }, "description": "When true, data includes playableIntake with optional routeIntegrity, proofCoverage, progress, progressStages, nextAction, blockedReasons, and coach." },
          { "name": "sessionId", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Optional player session used to mark discovered evidence, route progress, coach next step, and solved visibility." }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/case/proof-ledger": {
      "get": {
        "summary": "Rebuild the deterministic Truth Ledger and proof coverage for a case",
        "parameters": [
          { "name": "caseId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Optional player session used to mark covered obligations and proof gaps." },
          { "name": "includeCertificate", "in": "query", "required": false, "schema": { "type": "boolean" }, "description": "When true, data includes the spoiler-safe route certificate unless the session has solved the case." }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/investigation/autosolve": {
      "post": {
        "summary": "Run deterministic auto-solve for a case; dry-run by default and optionally persists a passing auto-player session",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/town/brief": {
      "get": {
        "summary": "Read a compact persistent town situation brief",
        "parameters": [{ "$ref": "#/components/parameters/WorldId" }],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/town/scenario/run": {
      "post": {
        "summary": "Run a deterministic baseline and counterfactual town scenario",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/town/case/extract": {
      "post": {
        "summary": "Extract a playable case from an emergence candidate; response may include playableIntake and 422 CASE_NOT_PLAYABLE for incomplete routes",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Ok" },
          "422": { "$ref": "#/components/responses/Ok" }
        }
      }
    },
    "/api/v1/query/town/scenario": {
      "get": {
        "summary": "Query a stored scenario run",
        "parameters": [
          { "$ref": "#/components/parameters/WorldId" },
          { "$ref": "#/components/parameters/ScenarioId" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/town/scenario/report": {
      "get": {
        "summary": "Query a stored scenario report",
        "parameters": [
          { "$ref": "#/components/parameters/WorldId" },
          { "$ref": "#/components/parameters/ScenarioId" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/town/snapshots": {
      "get": {
        "summary": "List public Time Machine snapshots",
        "parameters": [{ "$ref": "#/components/parameters/WorldId" }],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/town/snapshot/diff": {
      "get": {
        "summary": "Diff two Time Machine snapshots",
        "parameters": [
          { "$ref": "#/components/parameters/WorldId" },
          { "name": "from", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "to", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/town/snapshot/rollback": {
      "post": {
        "summary": "Rollback runtime state to a stored snapshot",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/benchmark/emergence": {
      "get": {
        "summary": "Query the latest emergence benchmark summary if available",
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/novel/import": {
      "post": {
        "summary": "Import text into Living World Lab",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/novel/projects": {
      "get": {
        "summary": "List persisted Living World Lab projects",
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/novel/project": {
      "get": {
        "summary": "Load a complete persisted Living World Lab workspace",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/query/novel/identities": {
      "get": {
        "summary": "Inspect persisted canonical entity identity decisions",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/novel/project/save": {
      "post": {
        "summary": "Save a Living World Lab workspace with optimistic conflict detection",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Ok" },
          "409": { "$ref": "#/components/responses/Ok" }
        }
      }
    },
    "/api/v1/query/novel/audit": {
      "get": {
        "summary": "Query a Living World Audit report",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/novel/correction/suggest": {
      "post": {
        "summary": "Suggest local correction patches for a novel project",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/novel/correction/apply": {
      "post": {
        "summary": "Apply a correction patch to the corrected view",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/novel/correction/revert": {
      "post": {
        "summary": "Revert an applied correction patch",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/novel/identity/resolve": {
      "post": {
        "summary": "Confirm or reject a pending entity identity match",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/command/novel/simulation/branch": {
      "post": {
        "summary": "Create a bounded counterfactual branch from a completed replay checkpoint",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    }
  },
  "components": {
    "parameters": {
      "WorldId": { "name": "worldId", "in": "query", "required": true, "schema": { "type": "string" } },
      "NpcId": { "name": "npcId", "in": "query", "required": true, "schema": { "type": "string" } },
      "ScenarioId": { "name": "scenarioId", "in": "query", "required": true, "schema": { "type": "string" } },
      "ProjectId": { "name": "projectId", "in": "query", "required": true, "schema": { "type": "string" } }
    },
    "requestBodies": {
      "JsonObject": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "responses": {
      "Ok": {
        "description": "Wrapped API response",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                { "$ref": "#/components/schemas/OkResponse" },
                { "$ref": "#/components/schemas/ErrorResponse" }
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "OkResponse": {
        "type": "object",
        "required": ["ok", "data"],
        "properties": {
          "ok": { "const": true },
          "data": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["ok", "error"],
        "properties": {
          "ok": { "const": false },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
